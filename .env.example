# Public browser configuration. Never use a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Only enable providers after configuring them in Supabase and their consoles.
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_FACEBOOK=false
NEXT_PUBLIC_AUTH_APPLE=false
# Canonical website origin used by the privacy policy, sitemap.xml and robots.txt at build time.
SITE_URL=https://qrcode-barcode-peach.vercel.app

# Public privacy support address displayed on the privacy policy page.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=gcappexplore1@gmail.com

# Public contact API URL. Leave blank until your delivery service is deployed.
# Accepts POST JSON {name,email,message}; returns 2xx JSON {"accepted":true}.
# Never put email-provider secrets here. Configure before building and redeploy.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Server-only Neon connection string. NEVER prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Optional server-only stable random secret for pseudonymous visit identifiers.
# If omitted, DATABASE_URL is used; rotating it resets device identity estimates.
ANALYTICS_HASH_SECRET=
